{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "journey",
  "main": "./worker.ts",
  "compatibility_date": "2026-05-15",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "workers_dev": true,
  "triggers": {
    "crons": [
      "*/5 * * * *"
    ]
  },
  "secrets": {
    "required": [
      "GITHUB_SYNC_KEY"
    ]
  },
  "queues": {
    "producers": [
      {
        "binding": "GITHUB_SYNC_QUEUE",
        "queue": "journey-github-sync"
      }
    ],
    "consumers": [
      {
        "queue": "journey-github-sync",
        "max_batch_size": 1,
        "max_batch_timeout": 1,
        "max_concurrency": 4,
        "max_retries": 3
      }
    ]
  },
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "journey",
      "database_id": "00000000-0000-4000-8000-000000000000",
      "migrations_dir": "./drizzle"
    }
  ],
  "r2_buckets": [
    {
      "binding": "BUCKET",
      "bucket_name": "journey-git"
    }
  ],
  "preview_urls": false,
  "vars": {
    "AVC_AUTH_MODE": "password"
  }
}
