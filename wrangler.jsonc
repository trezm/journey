{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "journey",
  "main": "./worker.ts",
  "compatibility_date": "2026-05-15",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "workers_dev": true,
  "triggers": {
    "crons": [
      "*/5 * * * *"
    ]
  },
  "secrets": {
    "required": [
      "GITHUB_SYNC_KEY"
    ]
  },
  "queues": {
    "producers": [
      {
        "binding": "GITHUB_SYNC_QUEUE",
        "queue": "journey-github-sync"
      }
    ],
    "consumers": [
      {
        "queue": "journey-github-sync",
        "max_batch_size": 1,
        "max_batch_timeout": 1,
        "max_concurrency": 4,
        "max_retries": 3
      }
    ]
  },
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "journey",
      "database_id": "9bc4583f-c7b0-4a34-a1e6-e38063214c2c",
      "migrations_dir": "./drizzle"
    }
  ],
  "r2_buckets": [
    {
      "binding": "BUCKET",
      "bucket_name": "journey-git"
    }
  ],
  "preview_urls": false,
  "vars": {
    "AVC_ACCESS_TEAM_DOMAIN": "mertz.cloudflareaccess.com",
    "AVC_ACCESS_AUD": "875efad6b43955c6a936e44b379a3074a7bd71f7309e8539cda974f4d39d0681",
    "AVC_OAUTH_ORIGIN": "https://journey.peter-s-mertz.workers.dev",
    "AVC_GITHUB_CLIENT_ID": "",
    "AVC_GITLAB_CLIENT_ID": "",
    "AVC_AUTH_MODE": "password"
  }
}
